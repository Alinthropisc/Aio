# App
APP_NAME=aioback
APP_VERSION=0.1.0
APP_DEBUG=false
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_ALLOWED_ORIGINS=["http://localhost:3000"]

# Primary Database (PostgreSQL)
DB_DRIVER=postgresql+psycopg
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aioback
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Secondary Database (MySQL) — отключена по умолчанию
SECONDARY_DB_ENABLED=false
SECONDARY_DB_DRIVER=mysql+aiomysql
SECONDARY_DB_HOST=localhost
SECONDARY_DB_PORT=3306
SECONDARY_DB_NAME=aioback
SECONDARY_DB_USER=root
SECONDARY_DB_PASSWORD=
SECONDARY_DB_POOL_SIZE=5
SECONDARY_DB_MAX_OVERFLOW=10
SECONDARY_DB_POOL_TIMEOUT=30
SECONDARY_DB_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10
REDIS_DECODE_RESPONSES=true

# Bot
BOT_TOKEN=your_bot_token_here
BOT_WEBHOOK_URL=
BOT_WEBHOOK_PATH=/webhook
BOT_USE_WEBHOOK=false
BOT_DROP_PENDING_UPDATES=true
